# ----------------------------------------------------------------------------
# Noor Al Salam Hotel - environment template.
# Copy to .env and fill in real values. NEVER commit .env.
# ----------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------
# Pooled PostgreSQL connection for the running app. `neon env pull` writes this.
# For local dev without Neon, run `npm run db:local` and use the localhost URL below.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/noor_al_salam"
# Direct PostgreSQL connection for Prisma Migrate. Leave empty to reuse DATABASE_URL.
DATABASE_URL_UNPOOLED=""
NEON_BRANCH=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Authentication -----------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-at-least-32-random-characters"

# --- Secret vault -------------------------------------------------------
# 32 bytes, base64 encoded. Used to encrypt OTA/channel-manager credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"

# --- Notifications ------------------------------------------------------
# console | smtp (smtp is not bundled; plug your provider into src/integrations/notifications)
EMAIL_PROVIDER="console"
SMS_PROVIDER="none"
WHATSAPP_PROVIDER="none"

# --- Online payments ----------------------------------------------------
# none | (future: moyasar | hyperpay | tap). With "none" only PAY_AT_HOTEL is offered.
PAYMENT_PROVIDER="none"

# --- Channel manager / OTA ---------------------------------------------
# none | mock (DEVELOPMENT ONLY, refused when NODE_ENV=production) | (future: real connectors)
CHANNEL_MANAGER="none"
# Real OTA credentials are entered in /admin/channels (stored encrypted), not here.
# Shared secret used to verify inbound webhooks per channel is stored in the same place.
OTA_CONFIGURATION=""

# --- Files --------------------------------------------------------------
# Neon Object Storage. `neon env pull` writes these. When all four are set, and
# PRIVATE_STORAGE_DIR is empty, uploads go to the buckets in neon.ts.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
# Housekeeping photographs and inventory images on local disk. Never put this inside public/.
# Set this to force the local directory even when Neon storage variables are present.
# Leave unset to use Neon when the AWS variables above are set, otherwise .data/private.
PRIVATE_STORAGE_DIR=""
# Maximum photograph size in bytes. Default 8388608 (8 MB).
HOUSEKEEPING_PHOTO_MAX_BYTES="8388608"
# Days to keep housekeeping photographs. 0 keeps them until removed by an operator.
HOUSEKEEPING_PHOTO_RETENTION_DAYS="365"

# --- Jobs ---------------------------------------------------------------
# Secret for calling /api/jobs/run from an external scheduler (cron, Vercel cron, etc.)
JOBS_SECRET="replace-with-random-string"

# --- Seed ---------------------------------------------------------------
# Password for the DEMO staff accounts created by `npm run db:seed` (development only)
SEED_DEMO_PASSWORD="ChangeMe-Demo-123"
