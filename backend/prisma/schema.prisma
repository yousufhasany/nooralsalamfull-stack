// Noor Al Salam Hotel - central database.
// The internal database is the single source of truth for reservations,
// inventory, guests, rooms, housekeeping and the financial ledger.
// OTAs are *channels*: they never own the core reservation model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum RoleKey {
  SUPER_ADMIN
  HOTEL_MANAGER
  RECEPTIONIST
  RESERVATION_MANAGER
  HOUSEKEEPING
  ACCOUNTANT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  DIRTY
  CLEANING
  MAINTENANCE
  OUT_OF_ORDER
}

enum RoomBlockType {
  MAINTENANCE
  OUT_OF_ORDER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum ReservationSource {
  DIRECT_WEBSITE
  BOOKING_COM
  AGODA
  TRIP_COM
  EXPEDIA
  PHONE
  WALK_IN
  OTHER
}

enum PaymentStatus {
  UNPAID
  PENDING
  PARTIALLY_PAID
  PAID
  PAY_AT_HOTEL
  PAID_BY_OTA
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  INFORMATION_NOT_PROVIDED
}

enum PaymentCollectionMethod {
  PAY_AT_HOTEL
  OTA_COLLECTED
  HOTEL_COLLECTED
  ONLINE_PAYMENT
  BANK_TRANSFER
  UNKNOWN
}

enum PaymentSource {
  DIRECT_WEBSITE
  BOOKING_COM
  AGODA
  TRIP_COM
  EXPEDIA
  HOTEL_CASH
  HOTEL_CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentRecordStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum FinancialTransactionType {
  ROOM_CHARGE
  ADDITIONAL_CHARGE
  DISCOUNT
  TAX
  PAYMENT
  REFUND
  OTA_COMMISSION
  OTA_PAYOUT
  ADJUSTMENT
  REVERSAL
}

// REVENUE  = what the stay is worth (charges, discounts, adjustments)
// TAX      = tax collected on behalf of the authority
// CASH     = money that actually moved (guest payments, refunds, OTA payouts)
// COMMISSION = amounts owed to / deducted by a channel
enum LedgerCategory {
  REVENUE
  TAX
  CASH
  COMMISSION
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum RatePlanType {
  STANDARD
  NON_REFUNDABLE
  BREAKFAST_INCLUDED
  HALF_BOARD
  FULL_BOARD
  CORPORATE
  PROMOTIONAL
}

enum AdjustmentType {
  FIXED
  PERCENT
}

enum PricingRuleType {
  LONG_STAY_DISCOUNT
  CHANNEL_ADJUSTMENT
  CORPORATE
  PROMOTIONAL
}

enum PromotionDiscountType {
  PERCENT
  FIXED
}

enum ChannelKind {
  OTA
  CHANNEL_MANAGER
}

enum ChannelConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  ERROR
  DISCONNECTED
}

enum SyncOperation {
  RESERVATION_PULL
  RESERVATION_IMPORT
  INVENTORY_PUSH
  RATE_PUSH
  RESTRICTION_PUSH
  RESERVATION_ACK
  WEBHOOK
  CONNECTION_TEST
}

enum SyncStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILED
}

enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  REJECTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  DISPUTED
  REFUNDED
  UNKNOWN
}

enum CommissionStatus {
  EXPECTED
  CONFIRMED
  DISPUTED
  WAIVED
}

enum ReconciliationStatus {
  MATCHED
  PARTIALLY_MATCHED
  UNMATCHED
  NEEDS_REVIEW
}

enum HousekeepingTaskStatus {
  OPEN
  IN_PROGRESS
  AWAITING_INSPECTION
  REJECTED
  COMPLETED
  CANCELLED
}

enum InventoryUnit {
  PIECE
  BOTTLE
  BOX
  KG
  LITRE
  PACK
}

enum InventoryLocationKind {
  MAIN
  FLOOR
  DEPARTMENT
  IN_TRANSIT
}

enum InventoryMovementType {
  RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  CONSUMPTION
  REVERSAL
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum TransferStatus {
  REQUESTED
  APPROVED
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum IssueDepartment {
  HOUSEKEEPING
  LAUNDRY
  MAINTENANCE
  KITCHEN
  FRONT_DESK
  OTHER
}

enum GalleryCategory {
  HOTEL
  ROOMS
  LOBBY
  RESTAURANT
  FACILITIES
  EXTERIOR
}

enum ModificationRequestStatus {
  OPEN
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

// ============================================================================
// IDENTITY & ACCESS
// ============================================================================

model Role {
  id          String           @id @default(cuid())
  key         RoleKey          @unique
  nameEn      String
  nameAr      String
  nameBn      String
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  roleId         String
  role           Role      @relation(fields: [roleId], references: [id])
  isActive       Boolean   @default(true)
  isDemo         Boolean   @default(false)
  tokenVersion   Int       @default(0)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  locale         String    @default("en")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  auditLogs         AuditLog[]
  roomStatusLogs    RoomStatusLog[]
  housekeepingTasks HousekeepingTask[]
  payments          Payment[]
  reservationsMade  Reservation[]      @relation("ReservationCreatedBy")
  bankReceipts      BankReceipt[]
  inventoryMovements InventoryMovement[]
  housekeepingPhotos HousekeepingPhoto[]
  inspectionsSubmitted HousekeepingInspection[] @relation("InspectionSubmitter")
  inspectionsReviewed  HousekeepingInspection[] @relation("InspectionReviewer")

  @@index([roleId])
}

// ============================================================================
// HOTEL & SETTINGS
// ============================================================================

model Hotel {
  id               String   @id @default(cuid())
  slug             String   @unique
  nameEn           String
  nameAr           String
  nameBn           String
  taglineEn        String   @default("")
  taglineAr        String   @default("")
  taglineBn        String   @default("")
  descriptionEn    String   @default("")
  descriptionAr    String   @default("")
  descriptionBn    String   @default("")
  addressEn        String   @default("")
  addressAr        String   @default("")
  addressBn        String   @default("")
  city             String   @default("")
  country          String   @default("SA")
  latitude         Decimal? @db.Decimal(9, 6)
  longitude        Decimal? @db.Decimal(9, 6)
  phone            String   @default("")
  whatsapp         String   @default("")
  email            String   @default("")
  logoUrl          String   @default("")
  heroImageUrl     String   @default("")
  contactHoursEn   String   @default("")
  contactHoursAr   String   @default("")
  contactHoursBn   String   @default("")
  mapEmbedUrl      String   @default("")
  currency         String   @default("SAR")
  timezone         String   @default("Asia/Riyadh")
  checkInTime      String   @default("15:00")
  checkOutTime     String   @default("12:00")
  vatNumber        String   @default("")
  commercialReg    String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  settings       HotelSetting[]
  roomTypes      RoomType[]
  rooms          Room[]
  reservations   Reservation[]
  facilities     Facility[]
  galleryImages  GalleryImage[]
  inventoryCategories InventoryCategory[]
  inventoryLocations  InventoryLocation[]
  inventoryItems      InventoryItem[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  stockTransfers      StockTransfer[]
  photoCategories     HousekeepingPhotoCategory[]
}

/// Key/value configuration (tax rules, policies, payment & notification config...).
model HotelSetting {
  id        String   @id @default(cuid())
  hotelId   String
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([hotelId, key])
}

// ============================================================================
// ROOMS & INVENTORY
// ============================================================================

model Amenity {
  id        String        @id @default(cuid())
  key       String        @unique
  nameEn    String
  nameAr    String
  nameBn    String
  icon      String        @default("check")
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  roomTypes RoomAmenity[]
}

model RoomType {
  id            String   @id @default(cuid())
  hotelId       String
  slug          String
  nameEn        String
  nameAr        String
  nameBn        String
  descriptionEn String   @default("")
  descriptionAr String   @default("")
  descriptionBn String   @default("")
  bedType       String   @default("")
  bedTypeAr     String   @default("")
  bedTypeBn     String   @default("")
  sizeSqm       Int?
  maxAdults     Int      @default(2)
  maxChildren   Int      @default(0)
  maxOccupancy  Int      @default(2)
  basePrice     Decimal  @db.Decimal(12, 2)
  weekendPrice  Decimal? @db.Decimal(12, 2)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  hotel               Hotel                    @relation(fields: [hotelId], references: [id])
  rooms               Room[]
  images              RoomImage[]
  amenities           RoomAmenity[]
  rates               RoomRate[]
  pricingRules        PricingRule[]
  reservationRooms    ReservationRoom[]
  promotions          PromotionRoomType[]
  channelMappings     ChannelRoomMapping[]
  channelRatePlanMaps ChannelRatePlanMapping[]
  channelInventory    ChannelInventory[]
  channelRates        ChannelRate[]
  channelRestrictions ChannelRestriction[]

  @@unique([hotelId, slug])
  @@index([hotelId, isActive])
}

model RoomAmenity {
  roomTypeId String
  amenityId  String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomTypeId, amenityId])
}

model RoomImage {
  id         String   @id @default(cuid())
  roomTypeId String
  url        String
  altEn      String   @default("")
  altAr      String   @default("")
  altBn      String   @default("")
  sortOrder  Int      @default(0)
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, sortOrder])
}

model Room {
  id         String     @id @default(cuid())
  hotelId    String
  roomTypeId String
  number     String
  floor      Int        @default(0)
  status     RoomStatus @default(AVAILABLE)
  isActive   Boolean    @default(true)
  notes      String     @default("")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  hotel            Hotel              @relation(fields: [hotelId], references: [id])
  roomType         RoomType           @relation(fields: [roomTypeId], references: [id])
  reservationRooms ReservationRoom[]
  blocks           RoomBlock[]
  statusLogs       RoomStatusLog[]
  tasks            HousekeepingTask[]

  @@unique([hotelId, number])
  @@index([roomTypeId, isActive])
  @@index([status])
}

/// Dated (or open-ended) removal of a physical room from sellable inventory.
model RoomBlock {
  id        String        @id @default(cuid())
  roomId    String
  type      RoomBlockType
  startDate DateTime      @db.Date
  endDate   DateTime?     @db.Date
  reason    String        @default("")
  createdAt DateTime      @default(now())
  room      Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startDate, endDate])
}

model RoomStatusLog {
  id         String      @id @default(cuid())
  roomId     String
  fromStatus RoomStatus?
  toStatus   RoomStatus
  userId     String?
  note       String      @default("")
  createdAt  DateTime    @default(now())
  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id])

  @@index([roomId, createdAt])
}

model HousekeepingTask {
  id               String                 @id @default(cuid())
  roomId           String
  type             String                 @default("CHECKOUT_CLEAN")
  status           HousekeepingTaskStatus @default(OPEN)
  assignedToId     String?
  notes            String                 @default("")
  createdAt        DateTime               @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  submittedAt      DateTime?
  /// Set once, when supplies are posted to the inventory ledger. Resubmission must not deduct again.
  suppliesDeducted Boolean                @default(false)
  room             Room                   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  assignedTo       User?                  @relation(fields: [assignedToId], references: [id])
  photos           HousekeepingPhoto[]
  inspections      HousekeepingInspection[]
  supplyLines      HousekeepingSupplyLine[]
  consumptions     InventoryConsumption[]

  @@index([status, createdAt])
  @@index([roomId])
}

/// Configurable cleaning photos. Managers choose which categories are mandatory.
model HousekeepingPhotoCategory {
  id        String   @id @default(cuid())
  hotelId   String
  code      String
  nameEn    String
  nameAr    String
  nameBn    String
  mandatory Boolean  @default(true)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  photos    HousekeepingPhoto[]

  @@unique([hotelId, code])
}

/// Metadata only. The image bytes live in private storage, never in PostgreSQL and never on a public URL.
model HousekeepingPhoto {
  id           String   @id @default(cuid())
  taskId       String
  categoryId   String
  uploadedById String
  storageKey   String   @unique
  mimeType     String
  byteSize     Int
  note         String   @default("")
  createdAt    DateTime @default(now())
  task         HousekeepingTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  category     HousekeepingPhotoCategory  @relation(fields: [categoryId], references: [id])
  uploadedBy   User                       @relation(fields: [uploadedById], references: [id])

  @@index([taskId, categoryId])
}

model HousekeepingInspection {
  id            String   @id @default(cuid())
  taskId        String
  attempt       Int
  status        String
  submittedById String
  submittedAt   DateTime @default(now())
  reviewedById  String?
  reviewedAt    DateTime?
  reason        String   @default("")
  areas         String   @default("")
  task          HousekeepingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedBy   User             @relation("InspectionSubmitter", fields: [submittedById], references: [id])
  reviewedBy    User?            @relation("InspectionReviewer", fields: [reviewedById], references: [id])

  @@unique([taskId, attempt])
  @@index([status, submittedAt])
}

model HousekeepingSupplyLine {
  id        String  @id @default(cuid())
  taskId    String
  itemId    String
  quantity  Decimal @db.Decimal(14, 3)
  task      HousekeepingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  item      InventoryItem    @relation(fields: [itemId], references: [id])

  @@unique([taskId, itemId])
}

model InventoryCategory {
  id        String   @id @default(cuid())
  hotelId   String
  code      String
  nameEn    String
  nameAr    String
  nameBn    String
  isActive  Boolean  @default(true)
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  items     InventoryItem[]

  @@unique([hotelId, code])
}

model InventoryLocation {
  id        String                @id @default(cuid())
  hotelId   String
  code      String
  nameEn    String
  nameAr    String
  kind      InventoryLocationKind
  isSystem  Boolean               @default(false)
  isActive  Boolean               @default(true)
  hotel     Hotel                 @relation(fields: [hotelId], references: [id])
  balances  InventoryBalance[]
  items     InventoryItem[]       @relation("ItemHomeLocation")
  movements InventoryMovement[]
  transfersFrom StockTransfer[]   @relation("TransferFrom")
  transfersTo   StockTransfer[]   @relation("TransferTo")
  adjustments   StockAdjustment[]

  @@unique([hotelId, code])
}

model Supplier {
  id          String    @id @default(cuid())
  hotelId     String
  name        String
  contactName String    @default("")
  phone       String    @default("")
  email       String    @default("")
  address     String    @default("")
  notes       String    @default("")
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  hotel       Hotel     @relation(fields: [hotelId], references: [id])
  items       InventoryItem[]
  orders      PurchaseOrder[]

  @@index([hotelId, isActive])
}

/// Weighted-average unit cost is stored on the item. Quantity lives on InventoryBalance per location.
model InventoryItem {
  id            String        @id @default(cuid())
  hotelId       String
  categoryId    String
  locationId    String
  supplierId    String?
  sku           String
  barcode       String?
  nameEn        String
  nameAr        String
  description   String        @default("")
  unit          InventoryUnit @default(PIECE)
  minQty        Decimal       @default(0) @db.Decimal(14, 3)
  reorderQty    Decimal       @default(0) @db.Decimal(14, 3)
  maxQty        Decimal?      @db.Decimal(14, 3)
  /// Weighted-average purchase cost in SAR. Updated only when stock is received.
  unitCost      Decimal       @default(0) @db.Decimal(14, 4)
  batchNumber   String        @default("")
  expiryDate    DateTime?     @db.Date
  imageKey      String?
  isActive      Boolean       @default(true)
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  hotel         Hotel              @relation(fields: [hotelId], references: [id])
  category      InventoryCategory  @relation(fields: [categoryId], references: [id])
  location      InventoryLocation  @relation("ItemHomeLocation", fields: [locationId], references: [id])
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  balances      InventoryBalance[]
  movements     InventoryMovement[]
  orderLines    PurchaseOrderItem[]
  transferLines StockTransferItem[]
  adjustments   StockAdjustment[]
  supplyLines   HousekeepingSupplyLine[]
  consumptions  InventoryConsumption[]

  @@unique([hotelId, sku])
  @@unique([hotelId, barcode])
  @@index([hotelId, isActive])
  @@index([expiryDate])
}

model InventoryBalance {
  itemId     String
  locationId String
  quantity   Decimal          @default(0) @db.Decimal(14, 3)
  item       InventoryItem    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location   InventoryLocation @relation(fields: [locationId], references: [id])

  @@id([itemId, locationId])
}

/// Append-only stock ledger. Corrections are new rows (ADJUSTMENT or REVERSAL), never updates.
model InventoryMovement {
  id           String                @id @default(cuid())
  itemId       String
  locationId   String
  type         InventoryMovementType
  /// Signed quantity: receipts positive, issues negative.
  quantity     Decimal               @db.Decimal(14, 3)
  unitCost     Decimal               @db.Decimal(14, 4)
  balanceAfter Decimal               @db.Decimal(14, 3)
  reference    String                @default("")
  note         String                @default("")
  userId       String?
  createdAt    DateTime              @default(now())
  item         InventoryItem         @relation(fields: [itemId], references: [id])
  location     InventoryLocation     @relation(fields: [locationId], references: [id])
  user         User?                 @relation(fields: [userId], references: [id])

  @@index([itemId, createdAt])
  @@index([type, createdAt])
  @@index([reference])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  hotelId      String
  number       String
  supplierId   String
  status       PurchaseOrderStatus @default(DRAFT)
  orderDate    DateTime            @db.Date
  expectedDate DateTime?           @db.Date
  notes        String              @default("")
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())
  hotel        Hotel               @relation(fields: [hotelId], references: [id])
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  items        PurchaseOrderItem[]

  @@unique([hotelId, number])
  @@index([status, orderDate])
}

model PurchaseOrderItem {
  id          String        @id @default(cuid())
  orderId     String
  itemId      String
  quantity    Decimal       @db.Decimal(14, 3)
  unitCost    Decimal       @db.Decimal(14, 4)
  receivedQty Decimal       @default(0) @db.Decimal(14, 3)
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item        InventoryItem @relation(fields: [itemId], references: [id])

  @@index([orderId])
}

model StockTransfer {
  id            String         @id @default(cuid())
  hotelId       String
  number        String
  fromLocationId String
  toLocationId  String
  status        TransferStatus @default(REQUESTED)
  notes         String         @default("")
  requestedById String?
  approvedById  String?
  createdAt     DateTime       @default(now())
  dispatchedAt  DateTime?
  receivedAt    DateTime?
  hotel         Hotel             @relation(fields: [hotelId], references: [id])
  fromLocation  InventoryLocation @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation    InventoryLocation @relation("TransferTo", fields: [toLocationId], references: [id])
  items         StockTransferItem[]

  @@unique([hotelId, number])
  @@index([status, createdAt])
}

model StockTransferItem {
  id            String        @id @default(cuid())
  transferId    String
  itemId        String
  quantity      Decimal       @db.Decimal(14, 3)
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item          InventoryItem @relation(fields: [itemId], references: [id])

  @@index([transferId])
}

model StockAdjustment {
  id            String           @id @default(cuid())
  itemId        String
  locationId    String
  previousQty   Decimal          @db.Decimal(14, 3)
  adjustedQty   Decimal          @db.Decimal(14, 3)
  reason        String
  status        AdjustmentStatus @default(PENDING)
  requestedById String?
  approvedById  String?
  createdAt     DateTime         @default(now())
  decidedAt     DateTime?
  item          InventoryItem     @relation(fields: [itemId], references: [id])
  location      InventoryLocation @relation(fields: [locationId], references: [id])

  @@index([status, createdAt])
}

/// One row per item per task. The unique key is the idempotency control for stock deduction.
model InventoryConsumption {
  id         String           @id @default(cuid())
  taskId     String
  itemId     String
  movementId String           @unique
  quantity   Decimal          @db.Decimal(14, 3)
  createdAt  DateTime         @default(now())
  task       HousekeepingTask @relation(fields: [taskId], references: [id])
  item       InventoryItem    @relation(fields: [itemId], references: [id])

  @@unique([taskId, itemId])
}

// ============================================================================
// PRICING
// ============================================================================

model RatePlan {
  id               String         @id @default(cuid())
  code             String         @unique
  type             RatePlanType
  nameEn           String
  nameAr           String
  nameBn           String
  descriptionEn    String         @default("")
  descriptionAr    String         @default("")
  descriptionBn    String         @default("")
  isRefundable     Boolean        @default(true)
  /// Adjustment applied to the room price for every night on this plan.
  adjustmentType   AdjustmentType @default(FIXED)
  adjustmentValue  Decimal        @default(0) @db.Decimal(12, 2)
  /// Number of free-cancellation days before check-in (null = policy default).
  freeCancelDays   Int?
  isDefault        Boolean        @default(false)
  isActive         Boolean        @default(true)
  isPublic         Boolean        @default(true)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  rates            RoomRate[]
  pricingRules     PricingRule[]
  reservations     Reservation[]
  reservationRooms ReservationRoom[]
  channelMappings  ChannelRatePlanMapping[]
  channelRates     ChannelRate[]
  channelRestrictions ChannelRestriction[]
}

/// Date-range price override (seasonal, event, promotional).
model RoomRate {
  id         String   @id @default(cuid())
  roomTypeId String
  ratePlanId String?
  label      String   @default("")
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  price      Decimal  @db.Decimal(12, 2)
  /// ISO weekdays 1(Mon)..7(Sun). Empty = every day.
  daysOfWeek Int[]
  priority   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  ratePlan   RatePlan? @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, startDate, endDate])
}

model PricingRule {
  id               String          @id @default(cuid())
  name             String
  type             PricingRuleType
  /// null = applies to every channel, otherwise only to this reservation source.
  source           ReservationSource?
  roomTypeId       String?
  ratePlanId       String?
  adjustmentType   AdjustmentType
  /// Signed: positive = markup, negative = discount.
  adjustmentValue  Decimal         @db.Decimal(12, 2)
  minNights        Int?
  maxNights        Int?
  startDate        DateTime?       @db.Date
  endDate          DateTime?       @db.Date
  priority         Int             @default(0)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  roomType         RoomType?       @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  ratePlan         RatePlan?       @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@index([type, isActive])
}

model Promotion {
  id             String                @id @default(cuid())
  code           String                @unique
  nameEn         String
  nameAr         String
  nameBn         String
  discountType   PromotionDiscountType
  amount         Decimal               @db.Decimal(12, 2)
  startDate      DateTime              @db.Date
  endDate        DateTime              @db.Date
  usageLimit     Int?
  usedCount      Int                   @default(0)
  minNights      Int?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  roomTypes      PromotionRoomType[]
  reservations   Reservation[]
}

model PromotionRoomType {
  promotionId String
  roomTypeId  String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  roomType    RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@id([promotionId, roomTypeId])
}

// ============================================================================
// GUESTS
// ============================================================================

model Guest {
  id             String    @id @default(cuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  nationality    String?
  idType         String?
  /// AES-256-GCM encrypted identification number (never stored in clear text).
  idNumberEnc    String?
  idLast4        String?
  address        String?
  notes          String    @default("")
  preferredLocale String   @default("en")
  isDemo         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  reservations Reservation[]
  invoices     Invoice[]

  @@index([email])
  @@index([phone])
  @@index([lastName, firstName])
}

// ============================================================================
// RESERVATIONS
// ============================================================================

model ReservationCounter {
  year  Int @id
  value Int @default(0)
}

model Reservation {
  id                   String                  @id @default(cuid())
  number               String                  @unique
  hotelId              String
  guestId              String
  source               ReservationSource
  channelId            String?
  externalReservationId String?
  status               ReservationStatus       @default(PENDING)
  paymentStatus        PaymentStatus           @default(UNPAID)
  paymentCollection    PaymentCollectionMethod @default(PAY_AT_HOTEL)
  ratePlanId           String?
  promotionId          String?
  checkIn              DateTime                @db.Date
  checkOut             DateTime                @db.Date
  nights               Int
  adults               Int
  children             Int                     @default(0)
  currency             String                  @default("SAR")
  roomsSubtotal        Decimal                 @default(0) @db.Decimal(12, 2)
  discountTotal        Decimal                 @default(0) @db.Decimal(12, 2)
  additionalChargesTotal Decimal               @default(0) @db.Decimal(12, 2)
  taxTotal             Decimal                 @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal                 @default(0) @db.Decimal(12, 2)
  /// Cached sum of succeeded guest/hotel-side payments (authoritative data is Payment).
  paidAmount           Decimal                 @default(0) @db.Decimal(12, 2)
  specialRequests      String                  @default("")
  internalNotes        String                  @default("")
  locale               String                  @default("en")
  cancelledAt          DateTime?
  cancelReason         String?
  checkedInAt          DateTime?
  checkedOutAt         DateTime?
  /// Set when a pending online-payment reservation holds inventory only until this time.
  holdExpiresAt        DateTime?
  /// true when an OTA delivered a confirmed booking that exceeded internal inventory.
  isOverbooked         Boolean                 @default(false)
  createdById          String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  deletedAt            DateTime?

  hotel               Hotel                @relation(fields: [hotelId], references: [id])
  guest               Guest                @relation(fields: [guestId], references: [id])
  channel             Channel?             @relation(fields: [channelId], references: [id])
  ratePlan            RatePlan?            @relation(fields: [ratePlanId], references: [id])
  promotion           Promotion?           @relation(fields: [promotionId], references: [id])
  createdBy           User?                @relation("ReservationCreatedBy", fields: [createdById], references: [id])
  rooms               ReservationRoom[]
  payments            Payment[]
  refunds             Refund[]
  transactions        FinancialTransaction[]
  invoices            Invoice[]
  additionalCharges   AdditionalCharge[]
  taxTransactions     TaxTransaction[]
  otaPayouts          OTAPayout[]
  otaCommissions      OTACommission[]
  channelReservation  ChannelReservation?
  modificationRequests ModificationRequest[]
  notes               ReservationNote[]
  reconciliations     ReconciliationRecord[]

  @@unique([source, externalReservationId])
  @@index([status, checkIn])
  @@index([checkIn, checkOut])
  @@index([guestId])
  @@index([source, createdAt])
  @@index([paymentStatus])
  @@index([createdAt])
}

model ReservationRoom {
  id            String   @id @default(cuid())
  reservationId String
  roomTypeId    String
  roomId        String?
  ratePlanId    String?
  checkIn       DateTime @db.Date
  checkOut      DateTime @db.Date
  adults        Int      @default(1)
  children      Int      @default(0)
  /// true while the parent reservation holds inventory (not cancelled/no-show/checked-out early).
  isBlocking    Boolean  @default(true)
  /// [{ date: "2026-06-10", price: "450.00" }, ...] - immutable pricing snapshot.
  nightlyRates  Json
  subtotal      Decimal  @db.Decimal(12, 2)
  /// Staff-entered price per night. Replaces the room type price, rates and rules whenever this line is priced.
  priceOverride Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  roomType    RoomType    @relation(fields: [roomTypeId], references: [id])
  room        Room?       @relation(fields: [roomId], references: [id])
  ratePlan    RatePlan?   @relation(fields: [ratePlanId], references: [id])

  @@index([roomTypeId, isBlocking, checkIn, checkOut])
  @@index([roomId, isBlocking, checkIn, checkOut])
  @@index([reservationId])
}

model ReservationNote {
  id            String      @id @default(cuid())
  reservationId String
  authorName    String
  body          String
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
}

model ModificationRequest {
  id             String                    @id @default(cuid())
  reservationId  String
  message        String
  requestedCheckIn  DateTime?              @db.Date
  requestedCheckOut DateTime?              @db.Date
  status         ModificationRequestStatus @default(OPEN)
  resolvedNote   String?
  createdAt      DateTime                  @default(now())
  resolvedAt     DateTime?
  reservation    Reservation               @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// ============================================================================
// PAYMENTS & FINANCIAL LEDGER
// ============================================================================

model Payment {
  id               String                  @id @default(cuid())
  reservationId    String
  invoiceId        String?
  amount           Decimal                 @db.Decimal(12, 2)
  currency         String                  @default("SAR")
  source           PaymentSource
  collectionMethod PaymentCollectionMethod
  status           PaymentRecordStatus     @default(SUCCEEDED)
  provider         String?
  providerReference String?
  reference        String?
  note             String                  @default("")
  receivedAt       DateTime                @default(now())
  recordedById     String?
  createdAt        DateTime                @default(now())

  reservation  Reservation @relation(fields: [reservationId], references: [id])
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id])
  recordedBy   User?       @relation(fields: [recordedById], references: [id])
  refunds      Refund[]

  @@unique([provider, providerReference])
  @@index([reservationId])
  @@index([receivedAt])
  @@index([source, status])
}

model Refund {
  id            String       @id @default(cuid())
  paymentId     String
  reservationId String
  amount        Decimal      @db.Decimal(12, 2)
  reason        String       @default("")
  status        RefundStatus @default(COMPLETED)
  provider      String?
  providerReference String?
  refundedAt    DateTime     @default(now())
  recordedById  String?
  createdAt     DateTime     @default(now())

  payment     Payment     @relation(fields: [paymentId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
}

/// Append-only ledger. Rows are never updated or deleted (enforced by DB trigger).
/// Corrections are made with ADJUSTMENT / REVERSAL rows.
model FinancialTransaction {
  id            String                   @id @default(cuid())
  reservationId String?
  invoiceId     String?
  paymentId     String?
  refundId      String?
  payoutId      String?
  commissionId  String?
  source        ReservationSource?
  type          FinancialTransactionType
  category      LedgerCategory
  /// Signed amount. See docs: charges positive, discounts negative, cash in positive, cash out negative.
  amount        Decimal                  @db.Decimal(14, 2)
  currency      String                   @default("SAR")
  description   String                   @default("")
  /// "STAY" for room charges (+ their tax/discount), "EXTRA:<additionalChargeId>" for extras,
  /// "CASH" for settlements. Used to reverse exactly one group of postings when it changes.
  scope         String                   @default("STAY")
  reversalOfId  String?                  @unique
  postedAt      DateTime                 @default(now())
  createdById   String?
  createdAt     DateTime                 @default(now())

  reservation Reservation? @relation(fields: [reservationId], references: [id])
  reversalOf  FinancialTransaction? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy  FinancialTransaction? @relation("Reversal")

  @@index([reservationId, postedAt])
  @@index([type, postedAt])
  @@index([source, postedAt])
  @@index([category, postedAt])
}

model AdditionalCharge {
  id            String    @id @default(cuid())
  reservationId String
  description   String
  category      String    @default("OTHER")
  quantity      Int       @default(1)
  unitPrice     Decimal   @db.Decimal(12, 2)
  amount        Decimal   @db.Decimal(12, 2)
  isTaxable     Boolean   @default(true)
  postedAt      DateTime  @default(now())
  voidedAt      DateTime?
  voidReason    String?
  postedById    String?
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
}

model TaxTransaction {
  id             String   @id @default(cuid())
  reservationId  String
  invoiceId      String?
  taxCode        String
  taxName        String
  rate           Decimal  @db.Decimal(7, 4)
  taxableAmount  Decimal  @db.Decimal(14, 2)
  /// Signed: reversals are posted as negative rows.
  taxAmount      Decimal  @db.Decimal(14, 2)
  scope          String   @default("STAY")
  postedAt       DateTime @default(now())
  reservation    Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@index([taxCode, postedAt])
}

model Invoice {
  id            String        @id @default(cuid())
  number        String        @unique
  reservationId String
  guestId       String
  status        InvoiceStatus @default(ISSUED)
  currency      String        @default("SAR")
  subtotal      Decimal       @db.Decimal(14, 2)
  discountTotal Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @db.Decimal(14, 2)
  paidTotal     Decimal       @default(0) @db.Decimal(14, 2)
  /// Immutable snapshot of hotel/guest details at issue time.
  snapshot      Json
  issuedAt      DateTime      @default(now())
  voidedAt      DateTime?
  voidReason    String?
  createdById   String?

  reservation Reservation @relation(fields: [reservationId], references: [id])
  guest       Guest       @relation(fields: [guestId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]

  @@index([reservationId])
}

model InvoiceCounter {
  year  Int @id
  value Int @default(0)
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)
  kind        String  @default("ROOM")
  sortOrder   Int     @default(0)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model OTAPayout {
  id               String       @id @default(cuid())
  channelId        String
  externalPayoutId String?
  reservationId    String?
  grossAmount      Decimal      @db.Decimal(14, 2)
  commissionAmount Decimal      @default(0) @db.Decimal(14, 2)
  taxAmount        Decimal      @default(0) @db.Decimal(14, 2)
  adjustmentAmount Decimal      @default(0) @db.Decimal(14, 2)
  netAmount        Decimal      @db.Decimal(14, 2)
  currency         String       @default("SAR")
  status           PayoutStatus @default(PENDING)
  payoutDate       DateTime?    @db.Date
  expectedPayoutDate DateTime?  @db.Date
  notes            String       @default("")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  channel      Channel      @relation(fields: [channelId], references: [id])
  reservation  Reservation? @relation(fields: [reservationId], references: [id])
  receipts     BankReceipt[]
  reconciliations ReconciliationRecord[]

  @@unique([channelId, externalPayoutId])
  @@index([status])
  @@index([reservationId])
}

model OTACommission {
  id               String           @id @default(cuid())
  channelId        String
  reservationId    String
  rate             Decimal?         @db.Decimal(7, 4)
  grossAmount      Decimal          @db.Decimal(14, 2)
  commissionAmount Decimal          @db.Decimal(14, 2)
  netHotelAmount   Decimal          @db.Decimal(14, 2)
  currency         String           @default("SAR")
  status           CommissionStatus @default(EXPECTED)
  createdAt        DateTime         @default(now())

  channel     Channel     @relation(fields: [channelId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@index([channelId, status])
  @@index([reservationId])
}

model BankReceipt {
  id          String    @id @default(cuid())
  payoutId    String?
  amount      Decimal   @db.Decimal(14, 2)
  currency    String    @default("SAR")
  receivedOn  DateTime  @db.Date
  reference   String    @default("")
  bankName    String    @default("")
  notes       String    @default("")
  recordedById String?
  createdAt   DateTime  @default(now())
  payout      OTAPayout? @relation(fields: [payoutId], references: [id])
  recordedBy  User?     @relation(fields: [recordedById], references: [id])

  @@index([payoutId])
  @@index([receivedOn])
}

model ReconciliationRecord {
  id               String               @id @default(cuid())
  reservationId    String
  payoutId         String?
  status           ReconciliationStatus
  expectedGross    Decimal              @db.Decimal(14, 2)
  expectedCommission Decimal            @db.Decimal(14, 2)
  expectedNet      Decimal              @db.Decimal(14, 2)
  ledgerNet        Decimal              @db.Decimal(14, 2)
  payoutNet        Decimal?             @db.Decimal(14, 2)
  bankReceived     Decimal?             @db.Decimal(14, 2)
  issues           Json
  reviewedById     String?
  reviewNote       String               @default("")
  createdAt        DateTime             @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])
  payout      OTAPayout?  @relation(fields: [payoutId], references: [id])

  @@index([reservationId, createdAt])
  @@index([status])
}

// ============================================================================
// CHANNELS (OTA / channel manager)
// ============================================================================

model Channel {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  kind         ChannelKind  @default(OTA)
  /// Which ReservationSource reservations from this channel carry.
  source       ReservationSource @default(OTHER)
  /// Key of the connector implementation in src/integrations/channels.
  providerKey  String
  isEnabled    Boolean      @default(true)
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())

  connection        ChannelConnection?
  roomMappings      ChannelRoomMapping[]
  ratePlanMappings  ChannelRatePlanMapping[]
  reservations      ChannelReservation[]
  syncLogs          ChannelSyncLog[]
  webhookEvents     ChannelWebhookEvent[]
  inventory         ChannelInventory[]
  rates             ChannelRate[]
  restrictions      ChannelRestriction[]
  syncJobs          SyncJob[]
  hotelReservations Reservation[]
  payouts           OTAPayout[]
  commissions       OTACommission[]
}

model ChannelConnection {
  id                String                  @id @default(cuid())
  channelId         String                  @unique
  status            ChannelConnectionStatus @default(NOT_CONNECTED)
  /// AES-256-GCM encrypted JSON blob. Never sent to the browser.
  credentialsEnc    String?
  webhookSecretEnc  String?
  /// Non-secret configuration (property id, endpoints supplied by the provider, ...).
  config            Json?
  hotelExternalId   String?
  isTestVerified    Boolean                 @default(false)
  lastTestAt        DateTime?
  lastTestOk        Boolean?
  lastTestMessage   String?
  lastSyncAt        DateTime?
  lastSuccessfulSyncAt DateTime?
  lastError         String?
  inventoryNeedsVerification Boolean        @default(false)
  connectedAt       DateTime?
  updatedAt         DateTime                @updatedAt
  channel           Channel                 @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

model ChannelRoomMapping {
  id             String   @id @default(cuid())
  channelId      String
  roomTypeId     String
  externalRoomId String
  externalRoomName String @default("")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  channel        Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  roomType       RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalRoomId])
  @@index([channelId, roomTypeId])
}

model ChannelRatePlanMapping {
  id                 String   @id @default(cuid())
  channelId          String
  ratePlanId         String
  roomTypeId         String?
  externalRatePlanId String
  externalRatePlanName String @default("")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  channel            Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  ratePlan           RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  roomType           RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalRatePlanId])
  @@index([channelId, ratePlanId])
}

/// Raw OTA reservation + link to the internal reservation.
model ChannelReservation {
  id                    String   @id @default(cuid())
  channelId             String
  externalReservationId String
  reservationId         String?  @unique
  externalStatus        String   @default("")
  payloadHash           String
  payload               Json
  version               Int      @default(1)
  importError           String?
  receivedAt            DateTime @default(now())
  updatedAt             DateTime @updatedAt

  channel     Channel      @relation(fields: [channelId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@unique([channelId, externalReservationId])
}

/// Idempotency record: one row per (channel, externalEventId).
model ChannelWebhookEvent {
  id              String             @id @default(cuid())
  channelId       String
  externalEventId String
  eventType       String
  payload         Json
  signatureValid  Boolean            @default(false)
  status          WebhookEventStatus @default(RECEIVED)
  error           String?
  attempts        Int                @default(0)
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  channel         Channel            @relation(fields: [channelId], references: [id])

  @@unique([channelId, externalEventId])
  @@index([status, receivedAt])
}

model ChannelSyncLog {
  id          String        @id @default(cuid())
  channelId   String
  jobId       String?
  operation   SyncOperation
  status      SyncStatus    @default(PENDING)
  referenceId String?
  recordCount Int           @default(0)
  failedCount Int           @default(0)
  error       String?
  retryCount  Int           @default(0)
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  channel     Channel       @relation(fields: [channelId], references: [id])

  @@index([channelId, startedAt])
  @@index([status])
}

/// Durable work queue (outbox) for pushes/pulls with exponential backoff.
model SyncJob {
  id           String        @id @default(cuid())
  channelId    String
  operation    SyncOperation
  payload      Json?
  /// Coalescing key so repeated pushes for the same scope collapse into one job.
  dedupeKey    String?
  status       SyncJobStatus @default(PENDING)
  attempts     Int           @default(0)
  maxAttempts  Int           @default(6)
  runAt        DateTime      @default(now())
  lockedAt     DateTime?
  lastError    String?
  createdAt    DateTime      @default(now())
  finishedAt   DateTime?
  channel      Channel       @relation(fields: [channelId], references: [id])

  @@index([status, runAt])
  @@index([channelId, dedupeKey, status])
}

/// Last availability pushed to a channel (what the OTA believes).
model ChannelInventory {
  id         String   @id @default(cuid())
  channelId  String
  roomTypeId String
  date       DateTime @db.Date
  available  Int
  pushedAt   DateTime @default(now())
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([channelId, roomTypeId, date])
}

model ChannelRate {
  id         String   @id @default(cuid())
  channelId  String
  roomTypeId String
  ratePlanId String
  date       DateTime @db.Date
  price      Decimal  @db.Decimal(12, 2)
  currency   String   @default("SAR")
  pushedAt   DateTime @default(now())
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([channelId, roomTypeId, ratePlanId, date])
}

model ChannelRestriction {
  id                String    @id @default(cuid())
  /// null = applies to the direct website and all channels.
  channelId         String?
  roomTypeId        String?
  ratePlanId        String?
  startDate         DateTime  @db.Date
  endDate           DateTime  @db.Date
  stopSell          Boolean   @default(false)
  minStay           Int?
  maxStay           Int?
  closedToArrival   Boolean   @default(false)
  closedToDeparture Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  channel           Channel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  roomType          RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  ratePlan          RatePlan? @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@index([startDate, endDate, isActive])
}

// ============================================================================
// CONTENT
// ============================================================================

model Facility {
  id            String   @id @default(cuid())
  hotelId       String
  slug          String
  nameEn        String
  nameAr        String
  nameBn        String
  descriptionEn String   @default("")
  descriptionAr String   @default("")
  descriptionBn String   @default("")
  icon          String   @default("sparkles")
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  hotel         Hotel    @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, slug])
}

model GalleryImage {
  id        String          @id @default(cuid())
  hotelId   String
  category  GalleryCategory
  url       String
  altEn     String          @default("")
  altAr     String          @default("")
  altBn     String          @default("")
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  hotel     Hotel           @relation(fields: [hotelId], references: [id])

  @@index([category, sortOrder])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  subject   String   @default("")
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// ============================================================================
// PLATFORM
// ============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  source     String   @default("ADMIN")
  ip         String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
}

model NotificationLog {
  id        String              @id @default(cuid())
  event     String
  channel   NotificationChannel
  recipient String
  subject   String              @default("")
  body      String
  status    NotificationStatus  @default(QUEUED)
  provider  String?
  error     String?
  referenceId String?
  createdAt DateTime            @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
  @@index([referenceId])
}

model RateLimitBucket {
  key        String   @id
  count      Int      @default(0)
  windowEnds DateTime

  @@index([windowEnds])
}
